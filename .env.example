# Copiar a .env y completar. No subir .env al repositorio.
# Requiere Microsoft ODBC Driver 18 for SQL Server instalado.
SQLSERVER_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=BOT_SUNEDU;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no"
SQL_POLL_SECONDS=5
