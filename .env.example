# Copiar a .env y completar. No subir .env al repositorio.
# Requiere Microsoft ODBC Driver 18 for SQL Server instalado.
# En Ubuntu usar autenticación SQL y la dirección del servidor SQL.
SQLSERVER_CONNECTION_STRING="DRIVER={ODBC Driver 18 for SQL Server};SERVER=servidor-sql,1433;DATABASE=BOT_SUNEDU;UID=usuario;PWD=clave;Encrypt=yes;TrustServerCertificate=no"
SQL_POLL_SECONDS=5
